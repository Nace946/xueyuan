.empty-state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f2f4f7;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.es-box {
  width: 56rpx;
  height: 44rpx;
  border: 4rpx solid #c8ced6;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.es-line {
  position: absolute;
  bottom: 30rpx;
  width: 72rpx;
  height: 4rpx;
  background: #c8ced6;
  border-radius: 2rpx;
}

.es-text {
  margin-top: 24rpx;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.es-sub {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}
