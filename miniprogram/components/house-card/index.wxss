.house-card {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 30, 50, 0.04);
}

.hc-img-wrap {
  position: relative;
  width: 220rpx;
  height: 170rpx;
  flex-shrink: 0;
}

.hc-img {
  width: 220rpx;
  height: 170rpx;
  border-radius: var(--radius-md);
  background: #eceff3;
}

.hc-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8a3d, #ff6b35);
  border-radius: 8rpx 0 12rpx 0;
}

.hc-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.hc-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.hc-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.hc-address {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

.hc-district {
  color: var(--color-primary);
  margin-right: 8rpx;
}

.hc-tags {
  margin-top: 8rpx;
  height: 36rpx;
  overflow: hidden;
  display: flex;
  flex-wrap: wrap;
}

.hc-footer {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.hc-price {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-price);
}

.hc-unit {
  font-size: var(--font-sm);
  color: var(--color-price);
  margin-left: 2rpx;
}

.hc-time {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
