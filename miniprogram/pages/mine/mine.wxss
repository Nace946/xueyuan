.page {
  padding-bottom: 60rpx;
}

.hero {
  background: linear-gradient(135deg, #2b7de9, #4f9bf5);
  padding: 48rpx 32rpx 64rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  margin: 20rpx 24rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 30, 50, 0.04);
}

.cell {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.cell:last-child {
  border-bottom: none;
}

.cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.cell-main {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.cell-title {
  font-size: var(--font-base);
  font-weight: 500;
}

.cell-desc {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

.cell-arrow {
  font-size: 36rpx;
  color: #c8ced6;
}

.card-title {
  font-size: var(--font-md);
  font-weight: 700;
  margin: 16rpx 0 8rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--color-primary);
  line-height: 1;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.contact-value {
  font-size: var(--font-base);
  color: var(--color-text);
}

.notice {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin: 8rpx 0;
}

.version {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
  margin-top: 40rpx;
}
