.page {
  padding-bottom: 40rpx;
}

.detail-skeleton {
  padding: 24rpx;
}

.skeleton-banner {
  height: 420rpx;
  margin-bottom: 24rpx;
}

.skeleton-line {
  height: 32rpx;
  margin-bottom: 20rpx;
}

.gallery {
  height: 480rpx;
}

.gallery-img {
  width: 100%;
  height: 480rpx;
  background: #eceff3;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-price);
}

.price-unit {
  font-size: var(--font-sm);
  color: var(--color-price);
  margin-left: 4rpx;
}

.deposit {
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.title {
  margin-top: 12rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
}

.sub-info {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.info-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  background: #f7f9fc;
  border-radius: var(--radius-md);
  padding: 20rpx 16rpx;
}

.info-cell {
  width: 50%;
  display: flex;
  margin-bottom: 16rpx;
}

.info-label {
  width: 130rpx;
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text);
}

.card-title {
  font-size: var(--font-md);
  font-weight: 700;
  margin-bottom: 16rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--color-primary);
  line-height: 1;
}

.facility {
  display: flex;
  flex-wrap: wrap;
}

.facility-item {
  width: 25%;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: 12rpx 0;
}

.address-row {
  display: flex;
  align-items: center;
}

.address-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
}

.address-copy {
  font-size: var(--font-sm);
  color: var(--color-primary);
  padding-left: 16rpx;
}

.desc-p {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.tips {
  margin: 24rpx;
  padding: 20rpx;
  font-size: var(--font-sm);
  color: #b26a00;
  background: #fff7e6;
  border-radius: var(--radius-md);
  line-height: 1.6;
}

.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid var(--color-line);
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  z-index: 50;
}

.action-info {
  display: flex;
  flex-direction: column;
  width: 220rpx;
}

.action-phone {
  font-size: var(--font-base);
  font-weight: 600;
}

.action-tip {
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

.action-btns {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  font-size: var(--font-base);
  margin-left: 16rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.btn-plain {
  background: #f2f4f7;
  color: var(--color-text);
}

.btn-share {
  background: #fff2e8;
  color: #ff6b35;
  font-size: var(--font-sm);
  padding: 0 24rpx;
}

.btn-share::after {
  border: none;
}
