<view class="page">
  <!-- 搜索 -->
  <view class="search-wrap">
    <view class="search-box">
      <image class="search-icon" src="/assets/icons/search.png" />
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索小区 / 地段 / 房源标题"
        placeholder-class="search-placeholder"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <text wx:if="{{keyword}}" class="search-btn" bindtap="onSearch">搜索</text>
    </view>
  </view>

  <!-- 筛选 -->
  <view class="filter">
    <scroll-view class="filter-row" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="chips">
        <view
          class="chip {{district === '' ? 'chip-active' : ''}}"
          data-value=""
          bindtap="onDistrictTap"
        >全部区域</view>
        <view
          wx:for="{{districts}}"
          wx:key="*this"
          class="chip {{district === item ? 'chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="onDistrictTap"
        >{{item}}</view>
      </view>
    </scroll-view>

    <scroll-view class="filter-row" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="chips">
        <view
          wx:for="{{priceRanges}}"
          wx:key="value"
          class="chip {{priceIndex === index ? 'chip-active' : ''}}"
          data-index="{{index}}"
          bindtap="onPriceTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="sort-row">
      <view
        wx:for="{{sorts}}"
        wx:key="value"
        class="sort-item {{sortIndex === index ? 'sort-active' : ''}}"
        data-index="{{index}}"
        bindtap="onSortTap"
      >{{item.label}}</view>
      <view class="sort-count">共 {{total}} 套</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{firstLoading}}" class="skeleton-list">
    <view wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this" class="skeleton-card">
      <view class="skeleton skeleton-line" style="width:55%"></view>
      <view class="skeleton skeleton-line" style="width:80%"></view>
      <view class="skeleton skeleton-line" style="width:45%"></view>
    </view>
  </view>

  <block wx:else>
    <house-item wx:for="{{list}}" wx:key="id" item="{{item}}" />
    <empty-state
      wx:if="{{!list.length}}"
      text="没有找到符合条件的房源"
      subText="试试调整筛选条件"
    />
    <load-more loading="{{loading}}" hasMore="{{hasMore}}" />
  </block>
</view>
