{
  "pages": [
    "pages/index/index",
    "pages/house/list/list",
    "pages/job/list/list",
    "pages/mine/mine"
  ],
  "subpackages": [
    {
      "name": "detail",
      "root": "pages/detail",
      "pages": [
        "house/house",
        "job/job",
        "webview/webview"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/house/list/list": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/job/list/list": {
      "network": "all",
      "packages": ["detail"]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "租房招聘通",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f6f8",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9aa0a6",
    "selectedColor": "#2b7de9",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/home.png",
        "selectedIconPath": "assets/icons/home-active.png"
      },
      {
        "pagePath": "pages/house/list/list",
        "text": "租房",
        "iconPath": "assets/icons/house.png",
        "selectedIconPath": "assets/icons/house-active.png"
      },
      {
        "pagePath": "pages/job/list/list",
        "text": "招聘",
        "iconPath": "assets/icons/job.png",
        "selectedIconPath": "assets/icons/job-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/icons/mine.png",
        "selectedIconPath": "assets/icons/mine-active.png"
      }
    ]
  },
  "permission": {},
  "requiredPrivateInfos": [],
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "style": "v2"
}
